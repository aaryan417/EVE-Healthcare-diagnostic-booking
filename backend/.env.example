# Django Security & Environment Configuration
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key

# PostgreSQL Database Configuration
DB_NAME=eve_healthcare
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT Token Expiry Configuration
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Automatic Demo Data Seeding (Enabled for local Docker/demo evaluation only)
SEED_DEMO_DATA=true

# Public Demo Accounts (For local assignment evaluation)
DEMO_PATIENT_EMAIL=patient@example.com
DEMO_PATIENT_PASSWORD=PatientPass123!
DEMO_PATIENT_NAME=Aaryan Verma

DEMO_CENTRE_ADMIN_EMAIL=centreadmin_a@clinic.com
DEMO_CENTRE_ADMIN_PASSWORD=AdminPass123!
DEMO_CENTRE_ADMIN_NAME=Centre Admin A

DEMO_SUPERUSER_EMAIL=admin@evehealthcare.com
DEMO_SUPERUSER_PASSWORD=AdminPass123!
DEMO_SUPERUSER_NAME=Demo Platform Admin
